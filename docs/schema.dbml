Table departments {
  department_id integer [pk]
  department_name text [not null, unique]
  department_description text
}

Table roles {
  role_id integer [pk]
  role_name text [not null]
  department_id integer [not null]
  level integer [not null]
  role_description text
}

Table skills {
  skill_id integer [pk]
  skill_name text [not null, unique]
  skill_category text [not null]
  skill_description text
}

Table employees {
  employee_id integer [pk]
  employee_name text [not null]
  current_role_id integer [not null]
  manager_id integer
  tenure_years real [not null]
  hire_date text
}

Table employee_skills {
  employee_id integer [not null]
  skill_id integer [not null]
  proficiency_level integer [not null, note: '1 to 5']
  last_updated text [not null]

  indexes {
    (employee_id, skill_id) [pk]
  }
}

Table role_skills {
  role_id integer [not null]
  skill_id integer [not null]
  required_level integer [not null, note: '1 to 5']
  importance_level integer [not null, note: '1 to 5']

  indexes {
    (role_id, skill_id) [pk]
  }
}

Table employee_career_interests {
  employee_id integer [not null]
  target_role_id integer [not null]
  created_at text [not null]
  visibility_level text [not null, default: 'private', note: 'one of: private, opening_managers']

  indexes {
    (employee_id, target_role_id) [pk]
  }
}

Table career_paths {
  career_path_id integer [pk]
  source_role_id integer [not null]
  target_role_id integer [not null]
  path_description text
}

Table job_openings {
  opening_id integer [pk]
  role_id integer [not null]
  hiring_manager_id integer [not null]
  headcount integer [not null]
  status text [not null, note: 'one of: open, paused, filled, closed']
  open_date text [not null]
}

Table training_programs {
  training_id integer [pk]
  training_name text [not null]
  estimated_weeks integer [not null]
  training_description text
}

Table training_skills {
  training_id integer [not null]
  skill_id integer [not null]
  course_skill_level integer [not null, note: '1 to 5']

  indexes {
    (training_id, skill_id) [pk]
  }
}

Table training_prerequisites {
  training_id integer [not null]
  skill_id integer [not null]
  minimum_level integer [not null, note: '1 to 5']

  indexes {
    (training_id, skill_id) [pk]
  }
}

Table employee_training_records {
  employee_id integer [not null]
  training_id integer [not null]
  status text [not null, note: 'one of: enrolled, in_progress, completed, withdrawn']
  enrollment_date text [not null]
  completion_date text
  assessment_score real
  passed integer

  indexes {
    (employee_id, training_id) [pk]
  }
}

Table future_demand {
  demand_id integer [pk]
  role_id integer [not null]
  planning_period text [not null]
  required_headcount integer [not null]
  created_at text [not null]
}

